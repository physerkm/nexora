# Copy to .env and adjust. Never commit the real .env.
JWT_SIGNING_KEY=change-me-to-a-long-random-secret-of-at-least-32-chars
# On a server use a long random password. It is applied only when the database volume is first created.
POSTGRES_PASSWORD=nexora
PLATFORM_ADMIN_EMAIL=admin@nexora.io
PLATFORM_ADMIN_PASSWORD=Nexora#2026
SEED_DEMO_DATA=true
ASPNETCORE_ENVIRONMENT=Production
# Only with docker-compose.prod.yml (HTTPS): the domain whose DNS points to this server.
# DOMAIN=app.example.com
# Database backups (docker-compose.prod.yml): how often, and how many days to keep in ./backups.
# BACKUP_INTERVAL_HOURS=24
# BACKUP_KEEP_DAYS=14
# Only with `docker compose --profile cache up`:
# REDIS_CONNECTION=redis:6379
