<Project>
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <NoWarn>$(NoWarn);CA1848;CA1515;CA1711;CA1716;CA1031;CA2007;CA1062;CA1724;CA1305;CA1307;CA1309;CA1310;CA1311;CA1304;CA1056;CA1054;CA1055;CA2227;CA1002;CA1819;CA1308;CA1812;CA5394;CA1873;CA1725;CA1859;CA1862;CA1000;CA1707</NoWarn>
  </PropertyGroup>
</Project>
