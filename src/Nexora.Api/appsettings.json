{
  "ConnectionStrings": {
    "Default": "Host=localhost;Port=5432;Database=nexora;Username=nexora;Password=nexora"
  },
  "Jwt": {
    "Issuer": "nexora",
    "Audience": "nexora-api",
    "SigningKey": "",
    "AccessTokenMinutes": 15,
    "RefreshTokenDays": 7
  },
  "Redis": {
    "ConnectionString": ""
  },
  "Database": {
    "InitializeOnStartup": true,
    "MigrateOnStartup": false
  },
  "Bootstrap": {
    "PlatformAdminEmail": "",
    "PlatformAdminPassword": ""
  },
  "Seed": {
    "DemoData": false,
    "TransactionsPerTenant": 1500
  },
  "Transactions": {
    "PendingExpiryHours": 72
  },
  "BackgroundJobs": {
    "Enabled": true,
    "OutboxIntervalSeconds": 5,
    "MaintenanceIntervalMinutes": 5,
    "OutboxBatchSize": 25
  },
  "RateLimiting": {
    "UserTokenLimit": 200,
    "UserTokensPerSecond": 20,
    "AnonymousPermitsPerMinute": 120,
    "AuthPermitsPerMinute": 10
  },
  "OpenApi": {
    "Enabled": true
  },
  "Cors": {
    "AllowedOrigins": []
  },
  "ReverseProxy": {
    "ForwardLimit": 0
  },
  "Serilog": {
    "Using": [ "Serilog.Sinks.Console" ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning",
        "System.Net.Http.HttpClient": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": { "formatter": "Serilog.Formatting.Compact.RenderedCompactJsonFormatter, Serilog.Formatting.Compact" }
      }
    ]
  },
  "AllowedHosts": "*"
}
